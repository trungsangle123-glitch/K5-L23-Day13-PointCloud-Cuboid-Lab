{
  "manifest_version": 3,
  "name": "CVAT Point Cloud Boost",
  "version": "1.3.0",
  "description": "Adjust point size and brightness in CVAT's 3D point-cloud view.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://cvat.edufun.ai/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://129.221.131.93:8080/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
